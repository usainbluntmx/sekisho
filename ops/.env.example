# Bot de alertas (BotFather). Nunca lo subas al repo: en GitHub va como secret.
TELEGRAM_BOT_TOKEN=
# Chat que recibe las alertas: npm run telegram:chat-id
TELEGRAM_CHAT_ID=

# Opcional: RPC propias (vacío = públicas con respaldo)
AVALANCHE_RPC_URL=
FUJI_RPC_URL=

# Opcional: token de GitHub para leer el CI sin límite anónimo (en Actions ya existe)
GITHUB_TOKEN=
