# ───────── Servidor ─────────
PORT=3000
# URL pública para armar los links de pago
PUBLIC_BASE_URL=http://localhost:3000
DB_PATH=data/kanjo.db

# ───────── Tienda ─────────
STORE_ID=cafe-kanjo
STORE_NAME=Café Kanjō
# Wallet del vendedor (dueño del SplitVault)
MERCHANT_ADDRESS=

# ───────── Agente IA (Claude) ─────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Horas de memoria de la conversación por cliente
HISTORY_HOURS=12

# ───────── Pagos (Avalanche Fuji) ─────────
# Wallet operadora (CON 0x): liquida pagos y reparte. Necesita AVAX. NO es owner de contratos.
OPERATOR_PRIVATE_KEY=
# RPC propia (recomendado en producción). Vacío = RPCs públicas de Fuji con respaldo automático
AVALANCHE_FUJI_RPC_URL=
# batch = reparto por lotes (recomendado) · each = reparto en cada pedido
DISTRIBUTE_MODE=batch
DISTRIBUTE_MIN_USDC=5
DISTRIBUTE_MAX_HOURS=24
DISTRIBUTE_CHECK_MINUTES=15

# ───────── Avisos ─────────
# console = imprime en logs · whatsapp = envía por WhatsApp
NOTIFY_CHANNEL=console
# WhatsApp de la tienda (código de país, sin + ni espacios)
MERCHANT_WA_ID=

# ───────── WhatsApp Cloud API (Meta) ─────────
GRAPH_API_VERSION=v23.0
# Sin WHATSAPP_TOKEN, las respuestas se imprimen en consola (modo prueba)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ───────── Desarrollo ─────────
# Si se define, habilita POST /dev/chat (quítalo en producción cuando WhatsApp esté activo)
DEV_CHAT_TOKEN=