# ───────── Servidor ─────────
PORT=3000
# URL pública para armar los links de pago
PUBLIC_BASE_URL=http://localhost:3000
DB_PATH=data/kanjo.db

# ───────── Tienda ─────────
STORE_ID=cafe-kanjo
STORE_NAME=Café Kanjō
# Wallet del vendedor (dueño del SplitVault)
MERCHANT_ADDRESS=

# ───────── Agente IA (Claude) ─────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Horas de memoria de la conversación por cliente
HISTORY_HOURS=12

# ───────── Pagos (Avalanche) ─────────
# Red: avalancheFuji (por defecto, testnet) o avalanche (mainnet, USDC real)
NETWORK=avalancheFuji
# Wallet operadora (CON 0x): liquida pagos y reparte. Necesita AVAX. NO es owner de contratos.
OPERATOR_PRIVATE_KEY=
# RPC propia de la red elegida (recomendado en producción). Vacío = RPCs públicas con respaldo automático
# (AVALANCHE_FUJI_RPC_URL se sigue aceptando, solo en Fuji)
AVALANCHE_RPC_URL=
# batch = reparto por lotes (recomendado) · each = reparto en cada pedido
DISTRIBUTE_MODE=batch
DISTRIBUTE_MIN_USDC=5
DISTRIBUTE_MAX_HOURS=24
# …solo si lo pendiente cubre el gas. Es un piso: debajo de este monto nada se reparte solo
DISTRIBUTE_AGE_MIN_USDC=0.25
# Si hay una subida de fee programada, reparte todo cuando falten estas horas o menos
DISTRIBUTE_FEE_CHANGE_HOURS=48
DISTRIBUTE_CHECK_MINUTES=15

# ───────── Catálogo desde URL (Firecrawl) ─────────
# npm run catalog:import -- <url>   (vista previa)  ·  npm run catalog:apply -- <id>
FIRECRAWL_API_KEY=
# Pesos por USDC para menús en MXN (p. ej. 18.5). Obligatoria solo si la página está en MXN
FX_MXN_PER_USDC=
# Stock con el que entran los productos nuevos y tope de productos por importación
CATALOG_DEFAULT_STOCK=20
CATALOG_MAX_ITEMS=200

# ───────── Voz (ElevenLabs) ─────────
ELEVENLABS_API_KEY=
# Voz en español: elige una en la Voice Library de ElevenLabs y copia su voice_id
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# on = canal de voz en el navegador (/voice): hablas y el agente responde en voz
VOICE_WEB=off
VOICE_WEB_PER_MINUTE=12
# on = notas de voz por WhatsApp (requiere WHATSAPP_TOKEN y WHATSAPP_PHONE_NUMBER_ID)
VOICE_REPLIES=off
# Arriba de este largo se responde en texto
VOICE_MAX_CHARS=600

# ───────── Avisos ─────────
# console = imprime en logs · whatsapp = envía por WhatsApp
NOTIFY_CHANNEL=console
# WhatsApp de la tienda (código de país, sin + ni espacios)
MERCHANT_WA_ID=

# ───────── WhatsApp Cloud API (Meta) ─────────
GRAPH_API_VERSION=v23.0
# Sin WHATSAPP_TOKEN, las respuestas se imprimen en consola (modo prueba)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ───────── Desarrollo ─────────
# Si se define, habilita POST /dev/chat (quítalo en producción cuando WhatsApp esté activo)
DEV_CHAT_TOKEN=