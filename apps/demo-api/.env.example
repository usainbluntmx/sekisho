# Red: avalancheFuji (por defecto, testnet) o avalanche (mainnet, USDC real)
NETWORK=avalancheFuji

# Wallet operadora (CON 0x): liquida los pagos y reparte. Solo necesita AVAX para gas.
# No es owner de ningún contrato. Usa una llave exclusiva para este servicio.
OPERATOR_PRIVATE_KEY=

# Vendedor: wallet TUYA que recibe el 98.5% de cada pago (dueña del SplitVault)
MERCHANT_ADDRESS=

# Precio por llamada en USDC
PRICE_USDC=0.01

# Opcional: RPC propia de la red elegida (vacío = RPCs públicas con respaldo automático)
AVALANCHE_RPC_URL=

# Opcional: política de reparto (valores por defecto del SDK: 5 / 24 / 0.25 / 48)
# DISTRIBUTE_MIN_USDC=5
# DISTRIBUTE_MAX_HOURS=24
# DISTRIBUTE_AGE_MIN_USDC=0.25
# DISTRIBUTE_FEE_CHANGE_HOURS=48
DISTRIBUTE_CHECK_MINUTES=15

# Opcional: peticiones por minuto por IP (las de pago incluidas)
RATE_LIMIT_PER_MINUTE=60

# Opcional: métricas on-chain en GET /v1/metrics (las lee la página /metrics del sitio)
# METRICS=on
# Wallets propias (pruebas) separadas por coma: sus pagos no cuentan como externos.
# El merchant y el operador de este servicio ya se incluyen solos.
# METRICS_OWN_WALLETS=0x...,0x...
# METRICS_SYNC_SECONDS=60
# METRICS_MAX_RANGE=2048
# METRICS_FROM_BLOCK=   (vacío = bloque de despliegue de la factory)

PORT=3000
