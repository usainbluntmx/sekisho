# Red de los ejemplos: avalancheFuji (por defecto) o avalanche (mainnet, dinero real)
SEKISHO_NETWORK=avalancheFuji

# Wallet que paga en los ejemplos de agente (CON prefijo 0x). Necesita USDC en la red elegida.
AGENT_PRIVATE_KEY=

# Wallet que liquida y reparte en los ejemplos de servidor (CON prefijo 0x). Necesita AVAX para gas.
FACILITATOR_PRIVATE_KEY=

# Opcional: vendedor de prueba (por defecto, uno de demo)
MERCHANT_ADDRESS=

# Opcional: precio del endpoint de seller-server y URL que paga agent-pay
PRICE_USDC=0.01
SERVER_URL=http://localhost:4021/premium

# Opcional: política de reparto (valores por defecto del SDK)
# DISTRIBUTE_MIN_USDC=5
# DISTRIBUTE_MAX_HOURS=24
# DISTRIBUTE_AGE_MIN_USDC=0.25
# DISTRIBUTE_FEE_CHANGE_HOURS=48

# Opcional: keeper independiente (examples/keeper.ts)
# KEEPER_PRIVATE_KEY=        # si falta, usa FACILITATOR_PRIVATE_KEY
# MERCHANTS=0xVendedor1,0xVendedor2
# KEEPER_INTERVAL_MINUTES=15
