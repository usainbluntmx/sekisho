{
  "name": "@zero-two-labs/sekisho",
  "version": "0.4.0",
  "description": "x402 payments with automatic revenue split on Avalanche",
  "main": "dist/index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "example:read": "tsx examples/read-config.ts",
    "example:seller": "node --env-file=.env --import tsx examples/seller-server.ts",
    "example:agent": "node --env-file=.env --import tsx examples/agent-pay.ts",
    "example:mcp": "node --env-file=.env --import tsx examples/agent-mcp.ts",
    "example:keeper": "node --env-file=.env --import tsx examples/keeper.ts",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "x402",
    "avalanche",
    "ai-agents",
    "mcp",
    "payments",
    "usdc",
    "revenue-split"
  ],
  "author": "Zero Two Labs",
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/mcp": "^2.28.0",
    "viem": "^2.57.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.5",
    "@x402/hono": "^2.28.0",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usainbluntmx/sekisho.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
